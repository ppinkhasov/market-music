# market-music configuration. Copy to `.env` and fill in.

# --- Spotify (required for playlist/playback features) ---
# Create an app at https://developer.spotify.com/dashboard
# Add this exact Redirect URI to the app settings:  http://127.0.0.1:8000/auth/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# --- DeepSeek (optional — app falls back to deterministic music mapping) ---
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Market polling ---
# --- Market data provider ---
# "yfinance" (free, ~15-min delayed, no key) or "polygon" (real-time stocks +
# futures, requires POLYGON_API_KEY with the matching entitlements).
MARKET_DATA_PROVIDER=yfinance
# Polygon API key — https://polygon.io. In "polygon" mode the basket is
# SPY,QQQ (stocks) + ES,NQ,BTC,ETH (futures) with VIX via yfinance; any symbol
# Polygon can't serve falls back to yfinance automatically.
POLYGON_API_KEY=

# Comma-separated tickers used in yfinance mode. Default: SPY,QQQ,BTC-USD,ETH-USD,^VIX
TRACKED_ASSETS=SPY,QQQ,BTC-USD,ETH-USD,^VIX
POLL_INTERVAL_SECONDS=45

# --- Weather (optional mood factor; no API key needed) ---
# Preset starting location (city or US ZIP). Can also be set live in the UI.
# When set, local weather tints the music (e.g. rain + a sideways market -> lo-fi).
# Leave blank to start with no location.
WEATHER_LOCATION=

# --- Playlist ---
PLAYLIST_NAME=Market Music 🎶 Live Mood
PLAYLIST_SIZE=25
PLAYLIST_PUBLIC=true

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Set true when serving over HTTPS so the session cookie gets the Secure flag.
# Leave false for local http://127.0.0.1 development.
COOKIE_SECURE=false
